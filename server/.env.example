# ============ EVE 国服 ESI / SSO 配置 ============
# 数据接口已于 2024 年迁移到 ali-esi.evepc.163.com
EVE_ESI_BASE_URL=https://ali-esi.evepc.163.com
# SSO 授权服务（无需修改）
EVE_SSO_BASE_URL=https://login.evepc.163.com
# 网易游戏 ID（国服 EVE 固定值，来自官方授权链接）
EVE_GAME_ID=aecfu6bgiuaaaal2-g-ma79

# ---- 客户端配置（官方未开放申请渠道，默认复用官方 ESI 网页自带 client_id，开箱即用） ----
# 留空时使用官方 ESI 网页自带 client_id（bc90aa496a404724a93f41b4f4e97761），第三方工具/KB网均用此 ID
# 若官方后续开放申请并发放专属客户端，在此填写并配置 EVE_DEVICE_ID
EVE_SSO_CLIENT_ID=
# 若官方提供 secret 则填写（国服通常仅用 client_id，可留空）
EVE_SSO_CLIENT_SECRET=
# device_id 官方不校验，任意值即可
EVE_DEVICE_ID=

# 回调地址：
# - 默认使用国服官方固定页面 https://ali-esi.evepc.163.com/ui/oauth2-redirect.html
#   （必须与官方客户端注册值一致；esi.evepc.163.com 旧域名已不被接受，勿改）
# - 授权完成后浏览器停留在此页，用户复制地址栏 URL 粘贴回后台完成绑定
# - 若你的应用被允许配置自有回调，可改成 http://localhost:3000/api/auth/callback
EVE_SSO_REDIRECT_URI=

# 授权 scope 分为「个人授权」与「军团授权」两套：
# - 个人授权（登录/绑定角色默认）：角色级 scope（钱包/技能/资产/蓝图/位置/邮件/市场/工业/击杀等）
# - 军团授权（系统设置里对角色二次授权）：个人授权 scope + 军团管理 scope，
#   需角色具备相应军团职位（Director/CEO 等）才能读取军团数据
# EVE_SCOPES：个人授权基础清单（空格分隔）。留空时使用内置个人授权完整组合。
# 国服 SSO 实测支持一次性携带大量 scope。
EVE_SCOPES=
# EVE_CORP_SCOPES：军团授权额外追加的军团管理 scope（空格分隔）。留空时使用内置组合：
#   esi-assets.read_corporation_assets.v1 esi-bookmarks.read_corporation_bookmarks.v1
#   esi-corporations.read_contacts.v1 esi-contracts.read_corporation_contracts.v1
#   esi-corporations.read_container_logs.v1 esi-corporations.read_divisions.v1
#   esi-corporations.read_facilities.v1 esi-corporations.read_medals.v1
#   esi-corporations.read_corporation_membership.v1 esi-corporations.track_members.v1
#   esi-corporations.read_titles.v1 esi-wallet.read_corporation_wallets.v1
#   esi-corporations.read_standings.v1 esi-corporations.read_structures.v1
#   esi-industry.read_corporation_jobs.v1 esi-killmails.read_corporation_killmails.v1
#   esi-planets.read_customs_offices.v1
EVE_CORP_SCOPES=

# ============ 平台配置 ============
PORT=3000
JWT_SECRET=please-change-me-to-a-random-string
# 数据库文件路径（SQLite）
DB_PATH=eveman.db
# 是否允许演示登录（未配置 SSO 时默认为 true）
ALLOW_MOCK_LOGIN=true

# ============ 安全合规（token 加密） ============
# ESI OAuth token 以 AES-256-GCM 加密落库，密钥由此配置派生。
# 生产环境务必配置（32 字节 base64，如 openssl rand -base64 32 生成），
# 一旦变更，旧密文将无法解密，需重新绑定角色。
# 未配置时回退到 APP_SECRET / 主机名派生临时密钥（仅限本地开发）。
TOKEN_ENC_KEY=
# 若未配置 TOKEN_ENC_KEY，也可用 APP_SECRET 作为加密密钥来源
APP_SECRET=
# 是否启用每日自动数据库备份（默认 true，保留最近 14 份 gzip 备份于 server/backups/）
BACKUP_ENABLED=true
