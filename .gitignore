# 依赖与构建产物
node_modules/
dist/

# 环境变量：真实配置不入库，仅保留模板 .env.example
.env
.env.*
!.env.example

# 本地 SQLite 数据库（含真实业务/加密 token 数据）
*.db
*.db-journal
*.db-shm
*.db-wal

# 数据库备份（gzip 后仍是完整业务数据）
server/backups/

# 日志
*.log
npm-debug.log*

# 系统 / 编辑器 / 临时文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tsbuildinfo
*.swp
